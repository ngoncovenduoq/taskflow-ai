# Copy to backend/.env and replace placeholders locally. Never commit real keys.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
TAVILY_API_KEY=replace_with_your_tavily_key

# Keep these aligned with the tested model configuration.
OPENROUTER_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b
